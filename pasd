<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>游戏账号注册中心</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:微软雅黑}
        body{background:#1e293b;min-height:100vh;display:flex;align-items:center;justify-content:center;color:#fff}
        .box{width:90%;max-width:420px;background:#334155;padding:35px;border-radius:12px;box-shadow:0 0 20px #00000040}
        h2{text-align:center;margin-bottom:25px;color:#38bdf8}
        .input-item{margin-bottom:18px}
        label{display:block;margin-bottom:6px;font-size:14px}
        input{width:100%;padding:12px;border-radius:6px;border:none;outline:none;background:#475569;color:#fff;font-size:15px}
        button{width:100%;padding:13px;border:none;border-radius:6px;background:#38bdf8;color:#000;font-weight:bold;font-size:16px;cursor:pointer;margin-top:10px}
        button:hover{background:#0ea5e9}
        .tip{margin-top:15px;text-align:center;font-size:13px;color:#94a3b8}
    </style>
</head>
<body>
    <div class="box">
        <h2>游戏专属账号注册</h2>
        <div class="input-item">
            <label>设置登录账号</label>
            <input type="text" id="username" placeholder="填写自定义账号名">
        </div>
        <div class="input-item">
            <label>设置登录密码</label>
            <input type="password" id="pwd" placeholder="设置登录密码">
        </div>
        <div class="input-item">
            <label>绑定个人邮箱</label>
            <input type="email" id="mail" placeholder="用于接收游戏聊天消息">
        </div>
        <button onclick="register()">提交注册</button>
        <div class="tip">注册成功后可在游戏内登录使用聊天功能</div>
    </div>

    <script>
        function getUserData(){
            let data = localStorage.getItem("gameUserList")
            return data ? JSON.parse(data) : []
        }
        function register(){
            let user = document.getElementById("username").value.trim()
            let pwd = document.getElementById("pwd").value.trim()
            let mail = document.getElementById("mail").value.trim()
            if(!user||!pwd||!mail){
                alert("所有内容必须填写完整！")
                return
            }
            let list = getUserData()
            let exist = list.find(item=>item.user===user)
            if(exist){
                alert("该账号已被注册！")
                return
            }
            list.push({user:user,pwd:pwd,email:mail})
            localStorage.setItem("gameUserList",JSON.stringify(list))
            alert("注册成功！请前往游戏内登录")
        }
    </script>
</body>
</html>
